programa {
  funcao inicio() {
    inteiro numero = 10
    real numeroReal = 12.5
    caracter opcao = 'a'
    logico status = verdadeiro
    cadeia frase = "a turma 06 é TOP!"

// Exibir os dados das variaveis na tela  
